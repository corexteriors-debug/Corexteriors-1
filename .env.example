# Vercel Postgres Credentials
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Google Cloud Service Account (for Calendar & Sheets)
# Base64 encoded JSON key to avoid newline issues in Vercel
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Cloud Service Account used by api/*.js (Calendar, contract e-signing, FB leads sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google IDs
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=

# Spreadsheet ID of "Residential Leads - London" (Facebook Lead Ads sync target, Sheet2)
# Share this sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer
GOOGLE_SHEET_ID_FB=

# Shared secret Vercel Cron sends as a Bearer token to protect /api/remind and /api/sync-fb-leads
CRON_SECRET=
